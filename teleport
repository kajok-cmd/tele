-- ข้อมูลคีย์ลัด (ใช้ร่วมกันทั้งคำสั่งหลักและจุดที่บันทึก)
-- id ของคำสั่งหลัก = ชื่อคำสั่ง, id ของจุด = "pt:" .. ชื่อจุด
----------------------------------------------------------------
local keybinds = {
    toggleGui     = Enum.KeyCode.RightShift,
    savePoint     = Enum.KeyCode.K,
    toggleAuto    = Enum.KeyCode.J,
    toggleReset   = Enum.KeyCode.L,
    toggleMarkers = Enum.KeyCode.H,
}

local keyButtons = {}
local listeningFor = nil

local function refreshKeyButton(id)
    local btn = keyButtons[id]
    if not btn then return end
    if listeningFor == id then
        btn.Text = "... กดคีย์"
        btn.BackgroundColor3 = Color3.fromRGB(180, 100, 40)
    else
        local key = keybinds[id]
        btn.Text = key and key.Name or "ไม่มี"
        btn.BackgroundColor3 = Color3.fromRGB(70, 130, 180)
    end
end

local function toggleListening(id)
    local previous = listeningFor
    listeningFor = (previous == id) and nil or id
    if previous then refreshKeyButton(previous) end
    refreshKeyButton(id)
end

