local function teleportTo(cframe)
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.CFrame = cframe + Vector3.new(0, 3, 0)
    end
end

-- ฟังก์ชันรีเซ็ตตัวละคร
local function resetCharacter()
    local character = player.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.Health = 0
        end
    end
end

-- สลับสถานะ Auto Reset
resetToggleBtn.MouseButton1Click:Connect(function()
    isAutoResetEnabled = not isAutoResetEnabled
    if isAutoResetEnabled then
        resetToggleBtn.Text = "✅ Auto Reset: เปิด"
        resetToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 100, 40)
        resetToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        resetToggleBtn.Text = "❌ Auto Reset: ปิด"
        resetToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        resetToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end)

-- ระบบวนวาร์ปอัตโนมัติ (Auto Teleport Loop)
task.spawn(function()
    while true do
        if isAutoTeleporting and #savedOrder > 0 then
            local totalPoints = #savedOrder
            for index, name in ipairs(savedOrder) do
                if not isAutoTeleporting then break end
                if savedLocations[name] then
                    teleportTo(savedLocations[name])
                    local delayTime = tonumber(autoDelayBox.Text) or 3
                    task.wait(math.max(0.5, delayTime))

                    -- เมื่อถึงจุดสุดท้าย และเปิดระบบ Auto Reset ไว้
                    if index == totalPoints and isAutoResetEnabled and isAutoTeleporting then
                        resetCharacter()
                        -- รอจนกว่าตัวละครจะเกิดใหม่สมบูรณ์
                        local newCharacter = player.CharacterAdded:Wait()
                        newCharacter:WaitForChild("HumanoidRootPart")
                        task.wait(1) -- รอสปอว์นเสร็จเรียบร้อย
                    end
                end
            end
        else
            task.wait(0.5)
        end
    end
end)

autoBtn.MouseButton1Click:Connect(function()
    isAutoTeleporting = not isAutoTeleporting
    if isAutoTeleporting then
        autoBtn.Text = "⏹️ หยุด Auto"
        autoBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    else
        autoBtn.Text = "▶️ เริ่ม Auto"
        autoBtn.BackgroundColor3 = Color3.fromRGB(70, 130, 180)
    end
end)

saveBtn.MouseButton1Click:Connect(function()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    local pointName = nameBox.Text
    if pointName == "" or pointName == " " then
        pointCount = pointCount + 1
        pointName = "จุดที่ " .. pointCount
    end

    local currentCFrame = character.HumanoidRootPart.CFrame
    savedLocations[pointName] = currentCFrame
    table.insert(savedOrder, pointName)

    local itemFrame = Instance.new("Frame")
    itemFrame.Size = UDim2.new(1, -6, 0, 30)
    itemFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    itemFrame.Parent = scrollFrame

    local itemCorner = Instance.new("UICorner")
    itemCorner.CornerRadius = UDim.new(0, 4)
    itemCorner.Parent = itemFrame

    local tpBtn = Instance.new("TextButton")
    tpBtn.Size = UDim2.new(0.7, 0, 1, 0)
    tpBtn.Position = UDim2.new(0, 0, 0, 0)
    tpBtn.BackgroundTransparency = 1
    tpBtn.Text = "  📍 " .. pointName
    tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    tpBtn.TextXAlignment = Enum.TextXAlignment.Left
    tpBtn.TextSize = 12
    tpBtn.Font = Enum.Font.SourceSans
    tpBtn.Parent = itemFrame

    local delBtn = Instance.new("TextButton")
    delBtn.Size = UDim2.new(0.25, 0, 0.8, 0)
    delBtn.Position = UDim2.new(0.72, 0, 0.1, 0)
    delBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    delBtn.Text = "ลบ"
    delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    delBtn.TextSize = 11
    delBtn.Font = Enum.Font.SourceSansBold
    delBtn.Parent = itemFrame

    local delCorner = Instance.new("UICorner")
    delCorner.CornerRadius = UDim.new(0, 4)
    delCorner.Parent = delBtn

    tpBtn.MouseButton1Click:Connect(function()
        if savedLocations[pointName] then
            teleportTo(savedLocations[pointName])
        end
    end)

    delBtn.MouseButton1Click:Connect(function()
        savedLocations[pointName] = nil
        for i, v in ipairs(savedOrder) do
            if v == pointName then
                table.remove(savedOrder, i)
                break
            end
        end
        itemFrame:Destroy()
    end)

    nameBox.Text = ""
end)
