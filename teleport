function actions.savePoint()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    local pointName = nameBox.Text
    if pointName == "" or pointName == " " then
        pointCount = pointCount + 1
        pointName = "จุดที่ " .. pointCount
    end

    -- ถ้าชื่อซ้ำ ให้ต่อท้ายเลข เพื่อให้คีย์ลัดของแต่ละจุดไม่ชนกัน
    if savedLocations[pointName] then
        local base = pointName
        local n = 2
        while savedLocations[base .. " (" .. n .. ")"] do
            n = n + 1
        end
        pointName = base .. " (" .. n .. ")"
    end

    local pointId = "pt:" .. pointName
    local currentCFrame = character.HumanoidRootPart.CFrame
    savedLocations[pointName] = currentCFrame
    table.insert(savedOrder, pointName)

    -- สร้างลูกบอลแสดงจุดในเกม
    createMarker(pointName, currentCFrame)

    local itemFrame = Instance.new("Frame")
    itemFrame.Size = UDim2.new(1, -6, 0, 30)
    itemFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    itemFrame.Parent = scrollFrame

    local itemCorner = Instance.new("UICorner")
    itemCorner.CornerRadius = UDim.new(0, 4)
    itemCorner.Parent = itemFrame

    local tpBtn = Instance.new("TextButton")
    tpBtn.Size = UDim2.new(0.5, 0, 1, 0)
    tpBtn.Position = UDim2.new(0, 0, 0, 0)
    tpBtn.BackgroundTransparency = 1
    tpBtn.Text = "  📍 " .. pointName
    tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    tpBtn.TextXAlignment = Enum.TextXAlignment.Left
    tpBtn.TextTruncate = Enum.TextTruncate.AtEnd
    tpBtn.TextSize = 12
    tpBtn.Font = Enum.Font.SourceSans
    tpBtn.Parent = itemFrame

    -- ปุ่มตั้งคีย์ลัดของจุดนี้
    local ptKeyBtn = Instance.new("TextButton")
    ptKeyBtn.Size = UDim2.new(0.26, 0, 0.8, 0)
    ptKeyBtn.Position = UDim2.new(0.51, 0, 0.1, 0)
    ptKeyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ptKeyBtn.TextSize = 10
    ptKeyBtn.Font = Enum.Font.SourceSansBold
    ptKeyBtn.Parent = itemFrame
    keyButtons[pointId] = ptKeyBtn

    local ptKeyCorner = Instance.new("UICorner")
    ptKeyCorner.CornerRadius = UDim.new(0, 4)
    ptKeyCorner.Parent = ptKeyBtn

    refreshKeyButton(pointId)

    local delBtn = Instance.new("TextButton")
    delBtn.Size = UDim2.new(0.2, 0, 0.8, 0)
    delBtn.Position = UDim2.new(0.78, 0, 0.1, 0)
    delBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    delBtn.Text = "ลบ"
    delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    delBtn.TextSize = 11
    delBtn.Font = Enum.Font.SourceSansBold
    delBtn.Parent = itemFrame

    local delCorner = Instance.new("UICorner")
    delCorner.CornerRadius = UDim.new(0, 4)
    delCorner.Parent = delBtn

    tpBtn.MouseButton1Click:Connect(function()
        if savedLocations[pointName] then
            teleportTo(savedLocations[pointName])
        end
    end)

    ptKeyBtn.MouseButton1Click:Connect(function()
        toggleListening(pointId)
    end)

    delBtn.MouseButton1Click:Connect(function()
        savedLocations[pointName] = nil
        for i, v in ipairs(savedOrder) do
            if v == pointName then
                table.remove(savedOrder, i)
                break
            end
        end
        -- ล้างคีย์ลัดและลูกบอลของจุดนี้
        keybinds[pointId] = nil
        keyButtons[pointId] = nil
        if listeningFor == pointId then
            listeningFor = nil
        end
        removeMarker(pointName)
        itemFrame:Destroy()
    end)

    nameBox.Text = ""
end

