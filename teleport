local function runBind(id)
    if actions[id] then
        actions[id]()
    elseif string.sub(id, 1, 3) == "pt:" then
        local name = string.sub(id, 4)
        if savedLocations[name] then
            teleportTo(savedLocations[name])
        end
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    -- โหมดตั้งคีย์ใหม่
    if listeningFor then
        local id = listeningFor
        listeningFor = nil

        if input.KeyCode == Enum.KeyCode.Escape then
            -- ยกเลิก ไม่เปลี่ยนอะไร
        elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
            keybinds[id] = nil
        else
            -- ถ้าคีย์ซ้ำกับรายการอื่น ให้ล้างของเดิมออก
            for otherId, key in pairs(keybinds) do
                if key == input.KeyCode and otherId ~= id then
                    keybinds[otherId] = nil
                    refreshKeyButton(otherId)
                end
            end
            keybinds[id] = input.KeyCode
        end

        refreshKeyButton(id)
        return
    end

    -- ไม่ทำงานตอนพิมพ์ในช่องข้อความ
    if gameProcessed then return end

    for id, key in pairs(keybinds) do
        if input.KeyCode == key then
            runBind(id)
            break
        end
    end
end)

----------------------------------------------------------------
-- ระบบวนวาร์ปอัตโนมัติ (Auto Teleport Loop)
----------------------------------------------------------------
task.spawn(function()
    while true do
        if isAutoTeleporting and #savedOrder > 0 then
            local totalPoints = #savedOrder
            for index, name in ipairs(savedOrder) do
                if not isAutoTeleporting then break end
                if savedLocations[name] then
                    teleportTo(savedLocations[name])
                    local delayTime = tonumber(autoDelayBox.Text) or 3
                    task.wait(math.max(0.5, delayTime))

                    -- เมื่อถึงจุดสุดท้าย และเปิดระบบ Auto Reset ไว้
                    if index == totalPoints and isAutoResetEnabled and isAutoTeleporting then
                        resetCharacter()
                        local newCharacter = player.CharacterAdded:Wait()
                        newCharacter:WaitForChild("HumanoidRootPart")
                        task.wait(1)
                    end
                end
            end
        else
            task.wait(0.5)
        end
    end
end)
